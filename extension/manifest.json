{
  "manifest_version": 3,
  "name": "annot",
  "version": "0.1.0",
  "description": "Mark up any page for your coding agent.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "annot (⌥A)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+A" }, "description": "Toggle annotate mode" }
  }
}
